# ==============================================================================
# ClairFlux — Modèle de variables d'environnement de production (.env.example)
# ==============================================================================
# Copiez ce fichier vers `.env` à la racine du dépôt : cp .env.example .env
# RÈGLE DE SÉCURITÉ : ne commitez JAMAIS votre `.env` réel dans Git.
# Aucune variable préfixée `VITE_` ne doit contenir un secret serveur.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environnement d'exécution global
# ------------------------------------------------------------------------------
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Base de données PostgreSQL Serverless Neon (OBLIGATOIRE : sslmode=require)
# ------------------------------------------------------------------------------
# Exemple Neon : postgresql://neondb_owner:MOT_DE_PASSE@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST.neon.tech/clairflux?sslmode=require

# ------------------------------------------------------------------------------
# 3. Sécurité & Authentification API (@clairflux/api)
# ------------------------------------------------------------------------------
# Hash Argon2id de votre secret personnel d'accès (minimum 16 caractères).
# Remplacez par le hash généré localement (jamais le mot de passe en clair).
CLAIRFLUX_ACCESS_SECRET_HASH=$argon2id$v=19$m=65536,t=3,p=4$CHANGE_ME_SALT$CHANGE_ME_HASH

# Secret HMAC-SHA256 signant les jetons de session `cfx_v1.*` (minimum 32 caractères).
# Génération : node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
CLAIRFLUX_SESSION_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS_SECRET

# Jeton interne partagé exclusivement entre `api` et `sync-worker` (minimum 16 caractères).
# Génération : node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
INTERNAL_WORKER_TOKEN=CHANGE_ME_GENERATE_AT_LEAST_16_RANDOM_CHARACTERS_TOKEN

# ------------------------------------------------------------------------------
# 4. Ingestion PDF Gemini & Google Drive (@clairflux/sync-worker uniquement)
# ------------------------------------------------------------------------------
# Clé API Google Gemini (transmise uniquement via l'en-tête HTTP `x-goog-api-key`).
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY

# Jeton d'accès Google Drive en lecture seule (`drive.readonly`).
# Périmètre verrouillé par code & contrainte SQL CHECK sur les 2 dossiers exclusifs :
#   - BoursoBank : 1cO74NPbgA7kp67Z3rkjAOMqFMDe_Ujus
#   - Revolut    : 1pGDvmcePbmIjxJ-lyKdeBMt974GxEx_h
GOOGLE_DRIVE_ACCESS_TOKEN=CHANGE_ME_GOOGLE_DRIVE_READONLY_TOKEN

# Chemin du fichier JSON de credentials monté dans le conteneur `sync-worker` (lecture seule :ro).
GOOGLE_DRIVE_CREDENTIALS_PATH=/run/secrets/google_drive_credentials.json

# Chemin du fichier JSON de credentials sur la machine hôte (monté vers GOOGLE_DRIVE_CREDENTIALS_PATH).
GOOGLE_DRIVE_CREDENTIALS_HOST_PATH=./secrets/google_drive_credentials.json

# ------------------------------------------------------------------------------
# 5. Exposition Web, CORS/CSRF & Artéfact APK Android
# ------------------------------------------------------------------------------
# Port HTTP exposé par le conteneur `web` (Nginx non-root).
CLAIRFLUX_WEB_PORT=8080

# Origine exacte autorisée pour la garde CSRF fail-closed de l'API (protocole + hôte + port si non standard).
CLAIRFLUX_WEB_ORIGIN=http://localhost:8080

# URL de base de l'API injectée au build du client Web / APK Capacitor.
# - `/api` lorsque le client passe par le reverse proxy Web Docker.
# - `https://clairflux.votre-domaine.fr/api` pour un APK mobile pointant vers votre API HTTPS.
VITE_API_BASE_URL=/api

# Version applicative affichée dans l'UI et exposée par `GET /api/apk/status` (via CLAIRFLUX_APP_VERSION).
VITE_APP_VERSION=1.0.0-rc1

# Chemin du fichier APK compilé lu par `api` (`GET /api/apk/status` et `GET /api/apk/download`).
APK_OUTPUT_PATH=/shared-apk/clairflux-release.apk
# Optionnel : version surchargée côté API si différente de VITE_APP_VERSION.
# CLAIRFLUX_APP_VERSION=1.0.0-rc1

# ------------------------------------------------------------------------------
# 6. Signature Release Android APK (OPTIONNEL — `apk-builder` / `scripts/build-apk.sh`)
# ------------------------------------------------------------------------------
# Laissez commenté en développement ou si vous signez ultérieurement.
# Ne commitez jamais de fichier *.jks / *.keystore / keystore.properties dans Git.
# ANDROID_KEYSTORE_PATH=/run/secrets/clairflux-release.jks
# ANDROID_KEYSTORE_PASSWORD=CHANGE_ME_KEYSTORE_PASSWORD
# ANDROID_KEY_ALIAS=clairflux
# ANDROID_KEY_PASSWORD=CHANGE_ME_KEY_PASSWORD
