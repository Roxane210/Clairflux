# syntax=docker/dockerfile:1

FROM eclipse-temurin:21-jdk-jammy AS apk-builder

ARG DEBIAN_FRONTEND=noninteractive
ARG NODE_MAJOR=22
ARG GRADLE_VERSION=8.11.1
ARG ANDROID_CMDLINE_TOOLS_VERSION=11076708
ARG ANDROID_COMPILE_SDK=35
ARG ANDROID_BUILD_TOOLS=35.0.0
ARG CAPACITOR_VERSION_RANGE=^7.0.0

ENV JAVA_HOME=/opt/java/openjdk \
    ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    GRADLE_HOME=/opt/gradle \
    GRADLE_USER_HOME=/opt/gradle-cache \
    APK_OUTPUT_DIR=/shared-apk \
    PATH="/opt/gradle/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/build-tools/${ANDROID_BUILD_TOOLS}:${PATH}"

# Dépendances système minimales + Node.js 22 LTS
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      coreutils \
      curl \
      git \
      gnupg \
      unzip \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Gradle reproductible
RUN curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o /tmp/gradle.zip \
    && unzip -q /tmp/gradle.zip -d /opt \
    && mv "/opt/gradle-${GRADLE_VERSION}" /opt/gradle \
    && rm -f /tmp/gradle.zip

# Android SDK Command-Line Tools & SDK 35 (platform-tools, platforms;android-35, build-tools;35.0.0)
RUN mkdir -p "${ANDROID_HOME}/cmdline-tools" \
    && curl -fsSL "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip" -o /tmp/cmdline-tools.zip \
    && unzip -q /tmp/cmdline-tools.zip -d /tmp/cmdline-unpack \
    && mv /tmp/cmdline-unpack/cmdline-tools "${ANDROID_HOME}/cmdline-tools/latest" \
    && rm -rf /tmp/cmdline-tools.zip /tmp/cmdline-unpack \
    && yes | sdkmanager --licenses >/dev/null \
    && sdkmanager --install \
      "platform-tools" \
      "platforms;android-${ANDROID_COMPILE_SDK}" \
      "build-tools;${ANDROID_BUILD_TOOLS}"

# Capacitor CLI, Core et Android (pré-installés globalement + sous /opt/capacitor sans modifier package.json)
RUN npm install -g --no-audit --no-fund \
      "@capacitor/cli@${CAPACITOR_VERSION_RANGE}" \
      "@capacitor/core@${CAPACITOR_VERSION_RANGE}" \
      "@capacitor/android@${CAPACITOR_VERSION_RANGE}" \
    && mkdir -p /opt/capacitor \
    && npm install --prefix /opt/capacitor --no-save --no-package-lock --no-audit --no-fund \
      "@capacitor/cli@${CAPACITOR_VERSION_RANGE}" \
      "@capacitor/core@${CAPACITOR_VERSION_RANGE}" \
      "@capacitor/android@${CAPACITOR_VERSION_RANGE}" \
    && npm cache clean --force

WORKDIR /app

# Copie uniquement les manifests et le périmètre frontend/shared (zéro secret serveur ni keystore)
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/api/package.json ./apps/api/package.json
COPY apps/sync-worker/package.json ./apps/sync-worker/package.json

RUN npm ci --ignore-scripts --workspace=@clairflux/web --workspace=@clairflux/shared --include-workspace-root \
    || npm install --ignore-scripts --no-audit --no-fund --workspace=@clairflux/web --workspace=@clairflux/shared --include-workspace-root

COPY packages/shared ./packages/shared
COPY apps/web ./apps/web
COPY scripts/build-apk.sh ./scripts/build-apk.sh

RUN chmod +x /app/scripts/build-apk.sh \
    && mkdir -p /shared-apk "${GRADLE_USER_HOME}"

VOLUME ["/shared-apk"]

CMD ["/app/scripts/build-apk.sh"]
